#cloud-config
package_update: true
packages:
  - docker.io
  - curl
  - gnupg
  - debian-keyring
  - debian-archive-keyring
  - apt-transport-https

write_files:
  # header_up -Via: bin/004's /loadbalanced check treats ANY "via" request header as a
  # signal to check for a GCP-style match (via containing "1.1 google") and, if that
  # specific match fails, never falls through to the Azure IMDS check at all -- it doesn't
  # independently evaluate each cloud. Caddy adds its own "Via: 1.1 Caddy" header to the
  # proxied request by default, which silently broke this endpoint until traced down to
  # the exact header via live debugging (docker exec + directly invoking bin/004).
  - path: /etc/caddy/Caddyfile
    content: |
      :80 {
        reverse_proxy 127.0.0.1:${app_port} {
          header_up -Via
        }
      }

      ${lb_hostname} {
        reverse_proxy 127.0.0.1:${app_port} {
          header_up -Via
        }
      }

runcmd:
  - systemctl enable --now docker
  - docker run -d --name quest --restart unless-stopped --log-driver journald -p 127.0.0.1:${app_port}:${app_port} -e SECRET_WORD='${secret_word}' ${image}
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
  - curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' -o /etc/apt/sources.list.d/caddy-stable.list
  # Ubuntu's own apt-daily/unattended-upgrades timers (and their own dpkg invocations) race
  # this runcmd stage for the dpkg lock on first boot. Stopping the timers first narrows the
  # window, but checking the lock is free and then running apt-get is still a
  # check-then-act race -- something else can grab the lock in between and "apt-get install"
  # still fails with "Could not get lock /var/lib/dpkg/lock-frontend". Retrying the actual
  # command on failure (rather than pre-checking) is what actually closes the race.
  # --force-confold: write_files above already wrote /etc/caddy/Caddyfile before caddy
  # installs, so dpkg's postinst sees a "modified" conffile and tries to interactively
  # prompt with no TTY (`end of file on stdin at conffile prompt`) without this.
  - systemctl stop apt-daily.timer apt-daily-upgrade.timer apt-daily.service apt-daily-upgrade.service
  - for i in $(seq 1 30); do apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y -o Dpkg::Options::=--force-confold caddy && break; sleep 5; done
  - systemctl restart caddy
